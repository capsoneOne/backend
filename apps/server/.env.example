# ============================================================
# Vendure server environment
# Copy to .env and fill in. Never commit the filled-in .env.
# ============================================================

APP_ENV=dev
VENDURE_SERVER_PORT=3000

# Signs session cookies. Any long random string; generate with:
#   openssl rand -base64 32
COOKIE_SECRET=

# Admin UI superadmin account, created on first run.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=

# ---------- Database (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vendure
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public

# ---------- Visual search embedding service ----------
# See docs/embedding-service-contract.md
EMBEDDER_URL=http://localhost:8000
# Which embedder implementation the container runs: stub | sim | fashion-clip-b32
# Compose reads this file, so the choice survives a container recreate —
# setting it only as a shell variable does not.
EMBEDDER_MODEL=stub
# EMBEDDER_TIMEOUT_MS=30000
# EMBEDDER_PER_ITEM_TIMEOUT_MS=5000

# ---------- Outbound email ----------
# Both SMTP_USER and SMTP_PASSWORD must be set for real delivery. With either
# missing, the server writes to the dev mailbox at http://localhost:3000/mailbox.
# SMTP_PASSWORD is a Google App Password (16 chars, no spaces) — NOT the account
# password. See "Sending real email" in README.md.
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_FROM=
STOREFRONT_URL=http://localhost:3001
# STOREFRONT_DEFAULT_LOCALE=en

# ---------- Telegram alerts ----------
# One forum group, one topic per alert type. Enable Topics in the group settings
# first — that converts it to a supergroup and changes the chat id to a -100...
# number. Leave a topic id blank to post into the group's General topic.
#
# NOTE: tokens are not device-bound — the same values work on any machine.
# For local development, prefer your OWN test group's chat id so you don't flood
# the shared/demo group with test alerts.
TELEGRAM_SALES_BOT_TOKEN=
TELEGRAM_OPS_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PAYMENTS_TOPIC_ID=
TELEGRAM_CONTACT_TOPIC_ID=
TELEGRAM_JOB_FAILURES_TOPIC_ID=
# TELEGRAM_TIMEOUT_MS=8000
# TELEGRAM_FAILED_JOB_SCHEDULE=*/5 * * * *

# ---------- Chat assistant ----------
GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=
# CHAT_MODEL=
# CHAT_BASE_URL=
# CHAT_MAX_OUTPUT_TOKENS=
# CHAT_MAX_HISTORY_MESSAGES=
# Rate limiting (all optional, sensible defaults in code)
# CHAT_ANONYMOUS_REQUESTS_PER_MINUTE=
# CHAT_ANONYMOUS_REQUESTS_PER_DAY=
# CHAT_USER_REQUESTS_PER_MINUTE=
# CHAT_USER_REQUESTS_PER_DAY=
# CHAT_GLOBAL_REQUESTS_PER_DAY=
# CHAT_GLOBAL_INPUT_TOKENS_PER_DAY=
# CHAT_GLOBAL_OUTPUT_TOKENS_PER_DAY=
# CHAT_MAX_CONCURRENT_REQUESTS=
# CHAT_LEASE_TTL_SECONDS=

# ---------- Cloudflare R2 asset storage ----------
# Omit all of these to fall back to local disk storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ---------- Contact form ----------
# Salt for hashing submitter IPs. Any long random string.
CONTACT_HASH_SALT=
# CONTACT_MAX_SUBMISSIONS_PER_HOUR=
# CONTACT_MAX_GLOBAL_SUBMISSIONS_PER_HOUR=

# ---------- Misc ----------
# JOB_QUEUE_CONCURRENCY=
# ASSET_READ_TIMEOUT_MS=

# NOTE: Stripe keys are NOT set here. Stripe is configured per channel in the
# Vendure Admin UI (Settings > Payment methods). The storefront needs only the
# publishable key — see apps/storefront/.env.example.
