  <diagram name="Indexing activity" id="activity-indexing">
    <mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#7C8794;" value="visual-search-capstone: indexing activity" vertex="1"><mxGeometry height="30" width="760" x="40" y="20" as="geometry" /></mxCell><mxCell id="3" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#7C8794;" value="Control flow that populates the vector index, including batching, partial failure, and retry." vertex="1"><mxGeometry height="20" width="760" x="40" y="50" as="geometry" /></mxCell><mxCell id="4" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1B1F27;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" value="Start" vertex="1"><mxGeometry height="44" width="110" x="460" y="100" as="geometry" /></mxCell><mxCell id="5" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=12;fontColor=#1B1F27;" value="Product event fires, or an administrator triggers a reindex" vertex="1"><mxGeometry height="66" width="230" x="400" y="180" as="geometry" /></mxCell><mxCell id="6" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=12;fontColor=#1B1F27;" value="Read embedder health and current model revision" vertex="1"><mxGeometry height="66" width="230" x="400" y="285" as="geometry" /></mxCell><mxCell id="7" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#0F766E;fontSize=11;fontColor=#115E59;" value="Vector width matches the schema?" vertex="1"><mxGeometry height="84" width="210" x="410" y="390" as="geometry" /></mxCell><mxCell id="8" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;fontSize=12;fontColor=#7F1D1D;" value="Abort and log the mismatch" vertex="1"><mxGeometry height