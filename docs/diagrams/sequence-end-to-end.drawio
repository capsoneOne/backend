        <mxCell id="band_a" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="1360" height="500" as="geometry" />
        </mxCell>
        <mxCell id="band_a_lbl" value="A · INDEXING — builds the vectors" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#0F766E;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="52" y="158" width="400" height="20" as="geometry" />
