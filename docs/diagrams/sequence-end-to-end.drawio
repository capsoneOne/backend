        <mxCell id="title" value="visual-search-capstone — end to end sequence" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Indexing builds the vectors. Query reads them back. Both halves meet at the embedder, the only place a model runs." style="text;html=1;fontSize=12;fontColor=#475569;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="900" height="20" as="geometry" />
