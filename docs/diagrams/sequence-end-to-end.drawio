        <mxCell id="ll_store" value="Storefront" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="90" width="150" height="1060" as="geometry" />
        </mxCell>
        <mxCell id="ll_server" value="Vendure Server" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="90" width="150" height="1060" as="geometry" />
