        <mxCell id="band_b" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="1360" height="450" as="geometry" />
        </mxCell>
        <mxCell id="band_b_lbl" value="B · QUERY — the user upload, end to end" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#9C4A22;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="52" y="678" width="400" height="20" as="geometry" />
        </mxCell>

        <mxCell id="ll_shopper" value="Shopper / Admin" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#E2E8F0;strokeColor=#475569;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="150" height="1060" as="geometry" />
